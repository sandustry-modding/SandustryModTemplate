{
  "name": "sandustry-mod-template",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/setup/ensure-types-repo.js",
    "setup": "node scripts/setup/setup.js",
    "build": "node scripts/build/esbuild.config.mjs",
    "dev": "node scripts/dev/dev.js",
    "dev:release": "node scripts/dev/dev.js --no-debug",
    "dev:pick": "node scripts/dev/dev.js --pick",
    "examples": "node scripts/dev/examples.js",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "node scripts/test/test.js",
    "test:integration": "node scripts/test/integration.js",
    "test:integration:view": "node scripts/test/integration.js --view",
    "lint": "npm run typecheck && oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "docs": "node scripts/docs/serve.js",
    "sandustry": "node scripts/sandustry/launch-sandustry.js",
    "publish": "node scripts/publish/publish-workshop.js"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@sandustry-modding/types": "file:SandustryTypes",
    "@types/node": "^26.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.1",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  }
}
